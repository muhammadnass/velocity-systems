# ============================================================
# VELOCITY SYSTEMS — Environment Variables
# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env
# NEVER commit the real .env file (it is git-ignored).
# ============================================================

# Port the Express server listens on (optional, defaults to 3000)
PORT=3000

# --- Paystack keys (get them from https://dashboard.paystack.com/#/settings/developers) ---

# SECRET key — SERVER ONLY. Used for webhook HMAC verification
# and server-side transaction verification. Keep it private.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PUBLIC key — safe to expose in the browser.
# NOTE: the front-end reads its public key from js/app.js (CONFIG.PAYSTACK_PUBLIC_KEY).
# This entry is kept here for reference / future server-rendered setups.
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
